// ============================================================
//  隔板顶置置物架 — Partition Top Shelf
//  参数化 OpenSCAD 模型
//  卡在工位隔板顶端，上方置物板用于放置物品
//  安装方式：对准隔板顶端垂直下压，弹性卡入，可反复拆装
// ============================================================
//
//  隔板剖面（沿长度方向看，挂钩空腔与其互补）：
//
//        panel_t
//   |----------------|   -- top_h（顶端段）
//   |                |
//   |--|          |--|   -- 顶端底面台阶（卡爪勾住此处）
//       |          |
//       | (凹槽)    |     -- 宽度深度无需精确，
//   |--|          |--|      只要收窄量 > claw_bite 即可
//   |                |
//
//  卡入原理：两侧壁下端各有一个小三角卡爪（尖端向内凸出
//  claw_bite ≈ 1.5mm，进入方向为缓斜面）。下压时隔板顶段
//  底面的台阶角沿斜面滑过，把两壁向外撑开约 1.5mm 后弹回，
//  卡爪上表面随即勾住隔板顶段底面的台阶。
//  承重：物品重量经置物板直接压在隔板顶面（留 vclr 悬浮
//  间隙）；卡爪只负责防脱落与定位，因此凹槽宽深无需实测。
//  拆卸：用力上拔，卡爪勾合面产生弹性变形即可脱出。

// ===== 隔板参数 =====

panel_t = 30;   // mm 隔板厚度（用户给定 3cm）
top_h   = 5;    // mm 隔板顶端到收窄处的距离（用户给定 5mm）

// ===== 置物架参数 =====

hook_length = 100;   // mm 1.长：沿轨道方向，与轨道长度相同
shelf_w     = 100;  // mm 2.宽：置物板总宽，与轨道居中对齐、两侧对称伸出
shelf_t     = 3;    // mm 3.置物板厚度
lip_h       = 2;    // mm 4.边缘凸缘高度（默认 2mm，防止物品滑落）

// ===== 卡爪与配合参数 =====

claw_bite = 1.5;   // mm 卡爪尖端向内凸出量（1~2mm，能勾住即可；
                   //    隔板顶端下方收窄量大于此值即可安装）
claw_h    = 3;     // mm 卡爪高度（决定进入斜面坡度，越大进入越省力）
wall      = 3;     // mm 侧壁厚度
clr       = 0.25;  // mm 宽腔侧向间隙（单边）
vclr      = 0.3;   // mm 竖向悬浮间隙（置物板底面与隔板顶面）

// ===== 预览开关 =====

show_on_panel = true;   // true=装配到隔板预览 / false=打印姿态

// ===== 内部派生尺寸 =====

_cav_w    = panel_t + 2 * clr;             // 宽腔宽度（容纳隔板顶端段）
_body_w   = panel_t + 2 * clr + 2 * wall;  // 挂钩主体宽度
_claw_z1  = -top_h;                        // 卡爪上表面（勾住顶段底面台阶）
_claw_z0  = _claw_z1 - claw_h;             // 卡爪斜面底端 = 主体下缘
_base_z   = _claw_z0;
_shelf_z0 = vclr;                          // 置物板底面（悬于隔板顶面上方）
_shelf_z1 = _shelf_z0 + shelf_t;           // 置物板顶面

assert(shelf_w >= _body_w, "shelf_w（置物板宽度）必须不小于挂钩主体宽度");
assert(claw_bite > 0 && claw_bite <= 3, "claw_bite 应在 0~3mm 之间");
assert(lip_h >= 0, "lip_h 不能为负");

// ============================================================
// ===== 模块定义 =====
// ============================================================

// ------------------------------------------------------------
// 置物板
//   与轨道居中对齐，两侧对称伸出
// ------------------------------------------------------------
module shelf() {
    translate([0, 0, _shelf_z0 + shelf_t / 2])
        cube([hook_length, shelf_w, shelf_t], center = true);
}

// ------------------------------------------------------------
// 防滑落凸缘
//   仅沿轨道方向布置两道（垂直于轨道的两端不设），
//   外侧面与置物板边缘齐平，平面内厚度与置物板相同
// ------------------------------------------------------------
module lips() {
    lip_t = shelf_t;   // 凸缘平面内厚度
    for (s = [1, -1])
        translate([0, s * (shelf_w / 2 - lip_t / 2), _shelf_z1 + lip_h / 2])
            cube([hook_length, lip_t, lip_h], center = true);
}

// ------------------------------------------------------------
// 侧壁（两根）
//   包裹隔板顶端段两侧，上接置物板，下缘与卡爪斜面底端齐平
// ------------------------------------------------------------
module rails() {
    for (s = [1, -1])
        translate([0, s * (panel_t / 2 + clr + wall / 2),
                   (_base_z + _shelf_z0) / 2])
            cube([hook_length, wall, _shelf_z0 - _base_z], center = true);
}

// ------------------------------------------------------------
// 卡爪（两只，直角三角形柱，沿长度方向贯通）
//   上边水平：勾住隔板顶段底面台阶（z = -top_h）
//   下边斜面：进入引导面，下压时隔板台阶沿此滑过撑开侧壁
//   尖端向内凸出 claw_bite，落入隔板顶端下方的收窄范围内
// ------------------------------------------------------------
module claw_half() {
    translate([hook_length / 2, 0, 0])
        rotate([0, -90, 0])          // 挤出方向：局部 +Z → 全局 -X
            linear_extrude(height = hook_length)
                polygon([
                    [-top_h, panel_t / 2 + clr],                // 壁面顶角
                    [-top_h, panel_t / 2 + clr - claw_bite],    // 尖端
                    [-top_h - claw_h, panel_t / 2 + clr],       // 壁面底角
                ]);
}

module claws() {
    claw_half();
    mirror([0, 1, 0])
        claw_half();
}

// ------------------------------------------------------------
// 宽腔：容纳隔板顶端段
//   只开到卡爪上表面高度，避免切除下方卡爪；
//   卡爪之间、卡爪以下区域保持敞开，供隔板收窄处通过
// ------------------------------------------------------------
module cavity() {
    translate([0, 0, (-top_h + _shelf_z0) / 2])
        cube([hook_length + 2, _cav_w, _shelf_z0 + top_h], center = true);
}

// ------------------------------------------------------------
// 置物架主体
// ------------------------------------------------------------
module partition_shelf() {
    difference() {
        union() {
            shelf();
            lips();
            rails();
            claws();
        }
        cavity();
    }
}

// ============================================================
// ===== 预览 / 打印模块 =====
// ============================================================

// 预览用的一段隔板（不打印；凹槽尺寸仅为示意，不影响实体模型）
module panel_preview() {
    seg = hook_length + 40;
    demo_groove_w = 20;
    demo_groove_h = 5;
    union() {
        translate([0, 0, -top_h / 2])
            cube([seg, panel_t, top_h], center = true);
        translate([0, 0, -top_h - demo_groove_h / 2])
            cube([seg, demo_groove_w, demo_groove_h], center = true);
        translate([0, 0, -top_h - demo_groove_h - 20])
            cube([seg, panel_t, 40], center = true);
    }
}

// 装配预览：置物架就位到隔板
module assembly() {
    color("Gray", 0.5)
        panel_preview();
    color("SteelBlue", 0.95)
        partition_shelf();
}

// 打印姿态：主体下缘贴床，无需支撑
//   卡爪进入斜面约 27° 自承；置物板底面一处 30.5mm 短桥接
module print_parts() {
    translate([0, 0, top_h + claw_h])
        partition_shelf();
}

// ============================================================
// ===== 执行入口 =====
// ============================================================

if (show_on_panel) {
    assembly();
} else {
    print_parts();
}

